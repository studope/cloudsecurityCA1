{
    "agent": {
      "metrics_collection_interval": 60,
      "run_as_user": "root"
    },
    "logs": {
      "logs_collected": {
        "files": {
          "collect_list": [
            {
              "file_path": "/var/log/httpd/access_log",
              "log_group_name": "/ca1/apache/access",
              "log_stream_name": "{instance_id}",
              "retention_in_days": 7
            },
            {
              "file_path": "/var/log/httpd/error_log",
              "log_group_name": "/ca1/apache/error",
              "log_stream_name": "{instance_id}",
              "retention_in_days": 7
            }
          ]
        }
      }
    },
    "metrics": {
      "namespace": "CWAgent",
      "metrics_collected": {
        "cpu": {
          "measurement": ["cpu_usage_idle", "cpu_usage_iowait"],
          "metrics_collection_interval": 60,
          "totalcpu": false
        },
        "disk": {
          "measurement": ["used_percent"],
          "metrics_collection_interval": 60,
          "resources": ["*"]
        },
        "mem": {
          "measurement": ["mem_used_percent"],
          "metrics_collection_interval": 60
        }
      }
    }
  }